<% if @mega_layout_section.rules == 'tabs' && request.env[:mega_rout][:action] == 'show' %>
  <%  @blocks.select{|blck| blck[:actions] == 'current'}.each do |block| %>
    <%= block[:html] %>
  <% end %>
  <ul class="mega-layout-section-tabs">
    <% @tabs.each_with_index do |t, idx|  %>
      <li class="<%= idx == 0 ? 'active' : '' %>"><%= t[:header] %></li>
    <% end %>
  </ul>
  <div id="content-tab">
    <% @tabs.each_with_index do |tab, idx| %>
      <div class="tab-content <%= idx == 0 ? 'active' : '' %>" style="<%= idx == 0 ? 'display: block;' : 'display: none;' %>">
        <%= tab[:html] %>
      </div>
    <% end %>
  </div>
<% else %>
  <% @blocks.each do |block| %>
    <%= block[:html] %>
  <% end %>
<%end %>

<script>
  // Inlined tab functionality to ensure it always runs.
  document.addEventListener("DOMContentLoaded", function () {
    function initializeTabs() {
      const tabItems = document.querySelectorAll(".mega-layout-section-tabs li");

      tabItems.forEach((tab, index) => {
        tab.addEventListener("click", function (e) {
          e.preventDefault();

          // Remove active class from all tabs and content
          document.querySelectorAll(".mega-layout-section-tabs li").forEach(el => el.classList.remove("active"));
          document.querySelectorAll(".tab-content").forEach(el => {
            el.classList.remove("active");
            el.style.display = "none";
          });

          // Add active class to clicked tab
          this.classList.add("active");

          // Show corresponding content
          const contentDiv = document.querySelector(`#content-tab .tab-content:nth-child(${index + 1})`);
          if (contentDiv) {
            contentDiv.classList.add("active");
            contentDiv.style.display = "block";
          }
        });
      });
    }
    initializeTabs();
  });
</script>