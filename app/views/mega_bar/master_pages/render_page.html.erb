<!DOCTYPE html>
<html lang="en">
  <head>
    <title>MEGA BAR yo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%# Rails 8 CSS - Load Bootstrap from CDN and application stylesheets %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous" />
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "stylesheets/mega_bar/mega_bar", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "stylesheets/mega_bar/mega_block_tabs", "data-turbo-track": "reload" %>
    
    <%# Rails 8 JavaScript via importmap %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= @page_classes %>">
    <h1 class="site_name" style=" margin-left: 18px;"><%= @site_name %></h1>
    <nav style="background-color: #eeeeee">
      <span style=" margin-left: 18px;">
        <%= link_to 'Home', '/' %>
        <%= link_if_can_index(MegaBar::Page, 'My Pages', mega_bar.pages_path, prepend: ' | ') %>
        <%= link_if_can_index(MegaBar::Model, 'My Models', mega_bar.models_path, prepend: ' | ') %>
      </span>
      <span style="float: right; margin-right: 18px;">
         <% if defined?(Devise) && user_signed_in? %>
           Logged in as <%= current_user.email %>  | 
           <%= link_to 'Log Out', main_app.destroy_user_session_path, method: :delete, data: { turbo_method: :delete } %> 
        <% elsif defined?(Devise) %>
          <% if should_show_admin_login_prompt? %>
            <span style="color: black;">Log in with your CCCUX admin role</span> | 
            <%= link_to 'Log In', main_app.new_user_session_path %> 
          <% else %>
            <%= link_to 'Sign Up', main_app.new_user_registration_path %> | 
            <%= link_to 'Log In', main_app.new_user_session_path %> 
          <% end %>
        <% end %>
      </span>
    </nav>
    <% flash.each do |key, msg| %>
      <div id="<%= key %>">
        <p><%= msg %></p>
        <div class="clear"></div>
      </div>
    <% end %>

    <% @page_layouts.each do |layout| %>
      <%=layout%>
    <% end %>
    <%= render partial: 'mega_bar_help_links' , locals: {:links => page_help_links} if administering_page? %>


<div class="container">
    <div class="row">
      <div class="col-md-6">
    <%= page_admin_link %>      
      </div>
    </div>
  </div>


    
    
    
    
    <%= render partial: 'shared/footer' if File.exist?(Rails.root.join('app', 'views', 'shared', '_footer.html.erb')) %>
    
    <nav id="mega_bar_footer_nav" style='background-color: #eeeeee'>
      <%= render "page_nav" %>
      <div class='admin-links'>To replace this global template, create a file at myapp/app/views/mega_bar/master_pages/render_page.html.erb that contains at least this: <span>&lt;% @page_layouts.each{ |layout| puts "&lt;div class='layout'&gt;#{layout}&lt;/div&gt;"  } %&gt;</span></div>
    </nav>
    <div>&nbsp;</div>
  </body>
</html>
