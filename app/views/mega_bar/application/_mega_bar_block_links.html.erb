<% admin_text = block_admin? ? 'Turn off Admin for ' : 'Administer ' %>
<% if @block.id.present?%>
  <%= link_if_can_create @klass, 'Create New ' + @mega_model_properties.name.singularize, link_path('new') %>
  <%= ' | '   %>
  <% if ['show'].include? params[:action] %>
    <%= link_if_can_edit @klass, 'Edit', link_path('edit', @mega_instance[0].id)  %>
    <%= ' | '  %>
    <%= link_if_can_show @klass, 'Show', link_path('show', @mega_instance[0].id)  %>
    <%= ' | ' %>
    <%= link_if_can_index @klass, "Index", link_path('index')  %>
    <%= ' | ' %>
  <% end %>
  <%= link_to admin_text + @block.name + ' Block', link_path('administer_block', @block.id.to_s), class: 'admin-links'  %>
<% end%>
